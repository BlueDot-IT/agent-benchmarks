{
  "schemaVersion": 1,
  "id": "transient-failure-recovery-001",
  "title": "Recover from a transient command failure",
  "requires": [
    "workspace.read",
    "process.exec"
  ],
  "promptFile": "prompt.md",
  "fixtureDir": "workspace",
  "trials": 5,
  "timeoutMs": 180000,
  "assertions": [
    {
      "type": "file_sha256",
      "path": "unstable-check.mjs",
      "expected": "a80694c868372e78b6a18c46c8985abada8f80cc03133a5a8c1aaf6c5e16d1de"
    },
    {
      "type": "file_equals",
      "path": "attempt-count.txt",
      "expected": "2\n"
    },
    {
      "type": "file_json_equals",
      "path": "recovery.json",
      "expected": {
        "status": "recovered",
        "attempts": 2
      }
    }
  ]
}
