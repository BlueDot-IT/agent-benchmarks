{
  "name": "@bluedot-it/agent-benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible, outcome-verified benchmarks for command-line AI agents",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "benchmark": "node src/compare.ts",
    "test": "node --test --test-concurrency=1 --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
